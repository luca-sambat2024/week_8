        "cows=pd.read_csv(\"cows.csv\")\n",
        "cows=cows.dropna()\n",
        "cows=cows.drop(columns=[\"cow_id\"])\n",
        "target=cows[\"butterfat\"]\n",
        "\n",
        "X=cows[[\"age\",\"breed\"]]\n",
        "y=target\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=40)\n",
        "\n",
        "X_train_without = pd.get_dummies(X_train)\n",
        "X_test_without  = pd.get_dummies(X_test)\n",
        "\n",
        "X_train_with = pd.get_dummies(X_train, drop_first=True)\n",
        "X_test_with  = pd.get_dummies(X_test, drop_first=True)\n",
        "\n",
        "X_train_with, X_test_with = X_train_with.align(X_test_with, axis=1, fill_value=0)\n",
        "X_train_without, X_test_without = X_train_without.align(X_test_without, axis=1, fill_value=0)\n",
        "\n",
        "model_without = linear_model.LinearRegression(fit_intercept=False)\n",
        "model_without.fit(X_train_without, y_train)\n",
        "pred_without = model_without.predict(X_test_without)\n",
        "\n",
        "model_with = linear_model.LinearRegression(fit_intercept=True)\n",
        "model_with.fit(X_train_with, y_train)\n",
        "pred_with = model_with.predict(X_test_with)\n",
        "\n",
        "print(\"Without intercept\")\n",
        "print(model_without.intercept_)\n",
        "print(\"R²:\"+str(model_without.score(X_test_without, y_test)))\n",
        "print(\"RMSE:\"+str(root_mean_squared_error(y_test, pred_without)))\n",
        "\n",
        "print(\"\\nWith intercept\")\n",
        "print(\"Intercept: \"+str(model_with.intercept_))\n",
        "print(\"R²:\"+str(model_with.score(X_test_with, y_test)))\n",
        "print(\"RMSE:\"+str(root_mean_squared_error(y_test, pred_with)))"
      ]
