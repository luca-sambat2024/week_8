        "X_train_cat = X_train.drop(columns=[\"Make_Year\", \"Mileage_Run\", \"Seating_Capacity\"])\n",
        "X_test_cat  = X_test.drop(columns=[\"Make_Year\", \"Mileage_Run\", \"Seating_Capacity\"])\n",
