        "X_test_num = X_test[[\"Make_Year\", \"Mileage_Run\", \"Seating_Capacity\"]]\n",
        "\n",
        "cars_regr_num.fit(X_train_num, Y_train)\n",
        "predicted = cars_regr_num.predict(X_test_num)\n",
        "\n",
        "for c in cars_regr_num.coef_:\n",
        "    print(c)\n",
        "print(\"Numerical Intercept: \"+str(cars_regr_num.intercept_))\n",
        "print(\"Numerical R² value: \"+str(cars_regr_num.score(X_test_num, Y_test)))\n",
        "print(\"Numerical RMSE value: \"+str(root_mean_squared_error(Y_test, predicted)))\n",
        "\n",
        "cars_regr_cat = linear_model.LinearRegression() # Do not use fit_intercept = False if you have removed 1 column after dummy encoding\n",
