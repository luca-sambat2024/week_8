        "X_5=df[[\"Review Scores Rating\", \"Neighborhood\",\"Property Type\"]]\n",
        "\n",
        "X_5 = pd.get_dummies(data=X_5, drop_first=True)\n",
        "\n",
        "X_train, X_test, Y_train, Y_test = train_test_split(X_5, y_target, test_size = .20, random_state = 40)\n",
        "\n",
        "regr_5 = linear_model.LinearRegression() # Do not use fit_intercept = False if you have removed 1 column after dummy encoding\n",
        "\n",
        "regr_5.fit(X_train, Y_train)\n",
        "predicted = regr_5.predict(X_test)\n",
        "\n",
        "counter=1\n",
        "for c in regr_5.coef_:\n",
        "    print(counter,c)\n",
        "    counter=counter+1\n",
        "print(\"Intercept: \"+str(regr_5.intercept_))\n",
        "print(\"R² value: \"+str(regr_5.score(X_test, Y_test)))\n",
        "print(\"RMSE value: \"+str(root_mean_squared_error(Y_test, predicted)))"
      ]
    },
