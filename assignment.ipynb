        "# 1. Compute the average prices and scores by `Neighborhood `; which borough is the most expensive on average? \n",
        "# Create a kernel density plot of price and log price, grouping by `Neighborhood `.\n",
        "\n",
        "df=df.rename(columns={\"Neighbourhood \":\"Neighborhood\"})\n",
        "neighborstats=df[[\"Neighborhood\",\"Review Scores Rating\",\"Price\"]]\n",
        "neighbors=df[\"Neighborhood\"].unique()\n",
        "n_price = neighborstats.groupby('Neighborhood')['Price'].mean()\n",
        "n_scores = neighborstats.groupby('Neighborhood')['Review Scores Rating'].mean()\n",
        "n_means=pd.DataFrame({\n",
        "    \"Price\": n_price,\n",
        "    \"Score\": n_scores\n",
        "}).reset_index()\n",
        "# neighborstats.head()\n",
        "n_means.head()\n",
        "fig, ax= plt.subplots(1,2, figsize=(10,4), sharey=True)\n",
        "sns.kdeplot(data=neighborstats, x=\"Price\", hue=\"Neighborhood\", fill=True, ax=ax[0])\n",
        "ax[0].set_title(\"Normal Price\")\n",
        "sns.kdeplot(data=neighborstats, x=\"Price\", hue=\"Neighborhood\", fill=True, ax=ax[1])\n",
        "ax[1].set_xscale(\"log\")\n",
        "ax[1].set_title(\"Log Price\")\n",
        "n_means.head()"
      ]
    },
