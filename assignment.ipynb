        "#   5. Use the `PolynomialFeatures` function from `sklearn` to expand the set of numerical variables you're using in the regression.\n",
        "#  As you increase the degree of the expansion, how do the $R^2$ and `RMSE` change? At what point does $R^2$ go negative on the test\n",
        "#  set? For your best model with expanded features, what is the $R^2$ and `RMSE`? How does it compare to your best model from part 4?\n",
        "rsquared=[]\n",
        "rmselist=[]\n",
        "\n",
        "for x in range(1,40):\n",
        "    poly=PolynomialFeatures(degree=x, include_bias=False)\n",
        "    X_train_num_poly = poly.fit_transform(X_train_num)\n",
        "    X_test_num_poly  = poly.transform(X_test_num)\n",
        "\n",
        "    cars_regr_num_poly = linear_model.LinearRegression()\n",
        "\n",
        "    cars_regr_num_poly.fit(X_train_num_poly, Y_train)\n",
        "    predicted = cars_regr_num_poly.predict(X_test_num_poly)\n",
        "\n",
        "    print(f\"Polynomial {x} Intercept: \"+str(cars_regr_num_poly.intercept_))\n",
        "    print(f\"Polynomial {x} R² value: \"+str(cars_regr_num_poly.score(X_test_num_poly, Y_test)))\n",
        "    print(f\"Polynomial {x} RMSE value: \"+str(root_mean_squared_error(Y_test, predicted))+\"\\n\")\n",
        "\n",
        "    rsquared.append(cars_regr_num_poly.score(X_test_num_poly, Y_test))\n",
        "    rmselist.append(root_mean_squared_error(Y_test, predicted))\n",
        "plt.plot(range(1,40),rsquared) #BLUE LINE\n",
        "plt.plot(range(1,40),rmselist) #ORANGE LINE"
      ]
    },
